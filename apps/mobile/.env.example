# Copy to .env.local for local builds. EXPO_PUBLIC_* values are compiled into the app,
# so only put public identifiers here — never secret keys.
EXPO_PUBLIC_API_URL=http://localhost:8790
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms

# RevenueCat *public* SDK keys (appl_... / goog_...)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Google Sign-In OAuth client IDs (public)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Reversed iOS client ID (com.googleusercontent.apps.<id>). Build time only, not EXPO_PUBLIC:
# the Google Sign-In config plugin registers it as a URL scheme. Leave empty to build without Google Sign-In.
GOOGLE_IOS_URL_SCHEME=
