# Copy to .dev.vars for local development. Never commit .dev.vars.
# Generate secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
REVENUECAT_WEBHOOK_AUTH=Bearer replace-with-a-long-random-string
# Lets the admin portal run locally without Cloudflare Access. Never set this in production.
ADMIN_DEV_BYPASS=1

# Optional locally (the mock translator and console email are used without them)
# GOOGLE_API_KEY=
# REVENUECAT_SECRET_KEY=
# APPLE_CLIENT_ID=com.translator.app
# APPLE_APP_BUNDLE_ID=com.translator.app
# GOOGLE_OAUTH_CLIENT_IDS=web-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com
# RESEND_API_KEY=
# EMAIL_FROM=Translator <no-reply@example.com>
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# ACCESS_AUD=

# Optional: real translations in development without a Google key (free, dev only)
# TRANSLATION_PROVIDER=mymemory
