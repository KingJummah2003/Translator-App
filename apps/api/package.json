{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply translator --local",
    "db:migrate:remote": "wrangler d1 migrations apply translator --remote --env production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "types": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@translator/shared": "*",
    "better-auth": "1.7.7",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
